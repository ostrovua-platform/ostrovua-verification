# Copy this file to Server/.env for local development only.
# Never commit a populated .env file. Production should prefer read-only
# /run/secrets mounts and the *_FILE variables supported by the service.

# Runtime
NODE_ENV=development
APP_ENV=development
PORT=3001
AUTH_BASE_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
HASURA_URL=http://localhost:8080/v1/graphql
ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=

# Authentication policy
JWT_EXPIRES=7d
BCRYPT_ROUNDS=12
INVITE_TTL_DAYS=7
AUTH_SESSION_ENFORCEMENT_ENABLED=0
VERIFY_DEV_BYPASS=0

# Release gates: keep disabled until the signed release gate is complete.
SELF_HOSTED_VERIFICATION_ENABLED=0
BIOMETRIC_CALIBRATION_APPROVED=0
BIOMETRIC_SHADOW_MODE_ENABLED=0
SERVER_OWNED_CA_ENABLED=0
BIOMETRIC_SHADOW_TESTER_IDS=

# Secret values for local development. Leave empty until provisioned.
JWT_SECRET=
HASURA_ADMIN_SECRET=
HASURA_EVENT_SECRET=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
LIVEKIT_API_SECRET=
TURN_STATIC_SECRET=

# File-backed secrets. Production should use these instead of inline values.
DOC_TOKEN_PEPPER_FILE=
DOC_TOKEN_PEPPER_PREVIOUS_FILE=
AUTH_RATE_LIMIT_PEPPER_FILE=
AUTH_SESSION_METADATA_PEPPER_FILE=
PASSWORD_RESET_PEPPER_FILE=
DOCUMENT_CA_SEALING_KEY_FILE=
BIOMETRIC_HMAC_SECRET_FILE=

# Public identifiers and endpoints
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
TELEGRAM_BOT_USERNAME=
RESEND_FROM=
LIVEKIT_API_KEY=
LIVEKIT_URL=
BIOMETRIC_SERVICE_URL=http://biometric:8081
BIOMETRIC_ENVELOPE_PUBLIC_KEY_FILE=
BIOMETRIC_ENVELOPE_PUBLIC_KEY_SHA256=

# Apple services
APPLE_TEAM_ID=
APP_BUNDLE_ID=
APPATTEST_ENV=development
APNS_BUNDLE_ID=
APNS_ENV=sandbox
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_TEAM_ID=

# ICAO trust material
CSCA_MASTERLIST=
CSCA_DSC=
CSCA_DSC_LOOKUP=
CSCA_ACTIVE_DSC=
CSCA_CRL=
PA_REQUIRE_UA=1
PA_NO_CHECK_TIME=0
